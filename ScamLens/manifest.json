{
  "manifest_version": 3,
  "name": "ScamLens",
  "version": "0.2.0",
  "description": "A local-first explainable scam-risk demo.",
  "permissions": ["tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ScamLens",
    "default_popup": "popup.html"
  }
}
